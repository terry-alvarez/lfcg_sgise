# Backend Environment Variables

# Environment
NODE_ENV=development
PORT=5000

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=sgise_user
DB_PASSWORD=sgise_password
DB_NAME=sgise_db
DATABASE_URL="postgresql://sgise_user:sgise_password@postgres:5432/sgise_db"

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production_12345
JWT_EXPIRE=24h
JWT_REFRESH_EXPIRE=7d

# API
API_BASE_URL=http://localhost:5000
API_PREFIX=/api/v1

# Socket.IO
SOCKET_ENABLED=true
SOCKET_CORS_ORIGIN=http://localhost:3000

# Logging
LOG_LEVEL=info

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,csv,xlsx

# Email (Futura integración)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_email_password
SMTP_FROM=noreply@sgise.com

# Feature Flags
FEATURE_BARCODE_READER=true
FEATURE_REAL_TIME=true
FEATURE_REPORTS=true
FEATURE_BIOMETRIC=false
